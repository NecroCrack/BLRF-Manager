// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MissionStatus {
  EN_COURS
  COMPLETE
  ARCHIVE
}

enum MissionType {
  COMBAT
  EXPLORATION
  LOGISTIQUE
  ESCORTE
  INTERNE
}

enum WaypointType {
  BASE
  OBJECTIF
  RAVITAILLEMENT
  AUTRE
}

enum ShipRole {
  COMBAT
  EXPLORATION
  MINAGE
  TRANSPORT
  MULTIROLE
}

enum ForumCategorie {
  OPERATIONS
  TACTIQUE
  INGENIERIE
  GENERAL
  ANNONCES
}

enum BuildStatus {
  EN_ATTENTE
  APPROUVE
  REJETE
}

// Configuration mono-ligne de l'escadron (id fixe "singleton").
model Squadron {
  id          String  @id @default("singleton")
  nom         String
  tag         String
  description String
  fondation   String
  // Data URI base64 (pas de stockage objet dédié pour ce projet à petite échelle).
  logo        String?
}

model Member {
  id           String    @id @default(uuid())
  matricule    String    @unique
  pseudo       String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  dateJoin     DateTime  @default(now())
  actif        Boolean   @default(true)
  lastSeenAt   DateTime?

  // Texte libre saisi à la main (legacy) — masqué côté client dès que localisationAuto=true.
  localisation          String?
  localisationSystemId  String?
  localisationSystem    System?   @relation("MemberLocalisation", fields: [localisationSystemId], references: [id], onDelete: SetNull)
  localisationUpdatedAt DateTime?
  localisationAuto      Boolean   @default(false)
  vaisseau       String?
  vaisseauModele String?
  specialite     String?
  combats        Int     @default(0)
  explorations   Int     @default(0)
  commerce       Int     @default(0)

  syncTokens  ExternalSync?
  apiToken    MemberApiToken?

  waypoints           Waypoint[]
  builds              ShipBuild[]
  buildComments       BuildComment[]
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  notes               PrivateNote[]
  missionsResponsable Mission[]         @relation("MissionResponsable")
  missionsAssigned    MissionAssignee[]
  messagesSent        Message[]         @relation("MessageSender")
  messagesReceived    Message[]         @relation("MessageRecipient")
  colonisationSitesAdded ColonisationSite[]
  factionSnapshotsReported FactionSnapshot[]

  @@index([roleId])
}

// Catalogue fixe des droits possibles (défini en code, seedé en base).
model Permission {
  key             String           @id
  label           String
  category        String
  rolePermissions RolePermission[]
}

// Rôle personnalisé défini par le commandant : nom + rang d'affichage.
// "protege" = rôle COMMANDANT seedé, non supprimable/renommable (garantit un super-admin).
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  // Titre affiché devant le pseudo (ex. "Amiral", "Commandant") — plusieurs grades
  // peuvent partager la même appellation, donc distinct de "name".
  appellation String           @default("")
  // Fonction/prérequis du grade, texte libre (fusionnés : pas de format assez
  // homogène côté escadron pour séparer proprement les deux en base).
  description String?
  rang        Int
  protege     Boolean          @default(false)
  members     Member[]
  permissions RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  granted       Boolean    @default(true)

  @@id([roleId, permissionKey])
}

// Jeton porteur pour le plugin EDMC (voir edmc-plugin/). Hashé (SHA-256), pas chiffré :
// c'est un identifiant d'authentification, pas un secret tiers à relayer comme inaraToken.
model MemberApiToken {
  id         String    @id @default(uuid())
  memberId   String    @unique
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model ExternalSync {
  id                 String    @id @default(uuid())
  memberId           String    @unique
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  inaraToken         String? // Chiffré (AES-256-GCM) via server/crypto.ts, jamais en clair
  inaraCommanderName String? // Nom CMDR Inara, peut différer du pseudo de l'escadron
  inaraLastSyncAt    DateTime?
  inaraLastSyncOk    Boolean?
  frontierAuth       String? // Tokens OAuth JSON, chiffrés (Phase 4+ future, non implémenté)
}

// Entité : Un système stellaire physique avec ses coordonnées
model System {
  id     String @id @default(uuid())
  name   String @unique
  coordX Float
  coordY Float
  coordZ Float

  waypoints           Waypoint[]
  missions            Mission[]
  membresLocalises    Member[]           @relation("MemberLocalisation")
  colonisationSites   ColonisationSite[]
  factionSnapshots    FactionSnapshot[]
}

// Site de colonisation suivi par l'escadron — progression alimentée automatiquement
// par le plugin EDMC (voir edmc-plugin/) une fois le système ajouté par un membre habilité.
model ColonisationSite {
  id            String   @id @default(uuid())
  systemId      String
  system        System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  name          String
  siteType      String
  progressPct   Float?
  statusText    String?
  // MarketID du journal Elite Dangerous (identifiant stable d'un dépôt de construction,
  // contrairement au nom qui peut changer une fois le site terminé). Nul pour les sites
  // ajoutés manuellement avant tout rapport du plugin EDMC.
  marketId      String?  @unique
  // Matériaux restants (ResourcesRequired de l'événement journal), poussés par le plugin EDMC —
  // alimente la recherche de marché (voir /api/colonisation/:id/check-system). Nul tant que le
  // plugin n'a pas encore rapporté ce site.
  resources     Json?
  lastUpdatedAt DateTime @default(now())
  addedById     String
  addedBy       Member   @relation(fields: [addedById], references: [id])
}

enum FactionSnapshotSource {
  PLUGIN // rapporté en direct par un membre équipé du plugin EDMC (FSDJump/Location)
  EDSM   // récupéré à la demande sur un système où aucun membre n'est passé récemment
}

// Faction mineure connue de l'escadron (pas seulement la sienne — toutes celles croisées dans un
// système suivi, utile pour situer le contexte BGS local). Une ligne par nom de faction, l'historique
// d'influence vit dans FactionSnapshot.
model Faction {
  id         String   @id @default(uuid())
  name       String   @unique
  allegiance String?
  government String?
  // Vrai dès qu'un snapshot a rapporté SquadronFaction=true dans le journal (Frontier identifie
  // lui-même la faction liée au Squadron in-game) — ou marqué à la main sinon (voir isSquadronManual).
  isSquadron       Boolean @default(false)
  isSquadronManual Boolean @default(false)
  snapshots  FactionSnapshot[]
}

// Photo d'influence d'une faction dans un système à un instant donné — table d'historique,
// jamais mise à jour en place (append-only), pour pouvoir calculer une tendance.
model FactionSnapshot {
  id               String   @id @default(uuid())
  factionId        String
  faction          Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)
  systemId         String
  system           System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  influence        Float
  state            String
  happiness        String?
  activeStates     Json?
  recoveringStates Json?
  pendingStates    Json?
  // Vrai si cette faction contrôlait le système au moment du rapport (SystemFaction du journal
  // ou controllingFaction d'EDSM).
  isControlling Boolean               @default(false)
  source        FactionSnapshotSource
  recordedAt    DateTime              @default(now())
  reportedById  String?
  reportedBy    Member?               @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([systemId, factionId, recordedAt])
}

// Entité : Un marqueur ajouté par l'escadron sur un système
model Waypoint {
  id          String       @id @default(uuid())
  systemId    String
  system      System       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   Member       @relation(fields: [createdById], references: [id])
  type        WaypointType @default(AUTRE)
  marker      String?
  pinned      Boolean      @default(false)
  timestamp   DateTime     @default(now())
}

model Mission {
  id             String        @id @default(uuid())
  title          String
  description    String
  status         MissionStatus @default(EN_COURS)
  priorite       Int           @default(3)
  type           MissionType   @default(INTERNE)
  systeme        String?
  systemId       String?
  system         System?       @relation(fields: [systemId], references: [id], onDelete: SetNull)
  responsableId  String?
  responsable    Member?       @relation("MissionResponsable", fields: [responsableId], references: [id])
  createdAt      DateTime      @default(now())
  dateCompletion DateTime?

  // Panneaux d'info live du dashboard : null = hérite du défaut du tableau de bord.
  showEdsmPanel         Boolean?
  showMemberStatusPanel Boolean?

  assignees MissionAssignee[]
}

// Membres assignés à une mission (distinct du "responsable" unique) — sert au
// panneau "statut des membres assignés" du tableau de bord.
model MissionAssignee {
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([missionId, memberId])
}

// Préférences d'épinglage du tableau de bord — globales à l'escadron (gérées par
// les membres avec le droit dashboard.manage), pas par utilisateur consultant.
model DashboardPreference {
  id               String   @id @default("singleton")
  pinnedMissionIds String[] @default([])
  pinnedSystemIds  String[] @default([])
}

model ShipBuild {
  id             String      @id @default(uuid())
  memberId       String
  member         Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  nom            String
  vaisseauModele String
  // Optionnel désormais : absent pour un build alimenté par le plugin EDMC ou importé au format
  // SLEF (le module en tient lieu). Toujours requis pour un build purement manuel.
  urlCoriolis    String?
  role           ShipRole    @default(MULTIROLE)
  portee         String?
  notes          String?
  status         BuildStatus @default(EN_ATTENTE)
  dateImport     DateTime    @default(now())
  // Modules détaillés (événement journal Loadout), poussés automatiquement par le plugin EDMC ou
  // collés manuellement au format SLEF. Nul pour un build purement manuel (lien Coriolis seul).
  modules        Json?
  // ShipID interne du jeu (emplacement du hangar, stable pour UN vaisseau physique tant qu'il
  // n'est pas vendu) — clé de dédoublonnage pour les mises à jour automatiques du plugin, qui
  // remplacent le build existant plutôt que d'en créer un nouveau à chaque changement de module.
  // Nul pour un build manuel ou importé en SLEF (jamais mis à jour automatiquement).
  shipId         Int?
  comments       BuildComment[]

  @@unique([memberId, shipId])
}

// Retour d'un membre habilité (droit builds.approve) sur un build — même forme que ForumComment.
model BuildComment {
  id        String    @id @default(uuid())
  buildId   String
  build     ShipBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer  Member    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
}

model ForumPost {
  id        String         @id @default(uuid())
  memberId  String
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String
  content   String
  categorie ForumCategorie @default(GENERAL)
  epingle   Boolean        @default(false)
  vues      Int            @default(0)
  createdAt DateTime       @default(now())
  comments  ForumComment[]
}

model ForumComment {
  id        String    @id @default(uuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
}

// Messagerie privée membre à membre : texte seul, aucune pièce jointe.
// Volume négligeable à l'échelle d'un escadron (pas de rétention/purge nécessaire).
model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      Member    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Member    @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  luAt        DateTime?

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model PrivateNote {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  titre     String
  categorie String   @default("Personnel")
  content   String
  createdAt DateTime @default(now())
  dateMaj   DateTime @updatedAt
}
